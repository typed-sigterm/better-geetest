{
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "tsdown -Ww",
    "play": "bun run --cwd playground dev",
    "build": "bun run --filter '*' build",
    "lint": "eslint .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@tsconfig/bun": "^1.0.11",
    "@typed-sigterm/eslint-config": "^1.7.1",
    "@types/bun": "1.4.0",
    "eslint": "^10.9.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
